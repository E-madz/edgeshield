# Copy to .env and adjust. Never commit the real .env file.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173

# MySQL container credentials (used by docker-compose)
MYSQL_DATABASE=edgeshield_db
MYSQL_USER=edgeshield
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-root

# Backend connection string (host "db" is the compose service name)
DATABASE_URL=mysql://edgeshield:change-me@db:3306/edgeshield_db

# Redis (rate limiting). Host "redis" is the compose service name.
REDIS_URL=redis://redis:6379/0

# Celery broker (Redis database 1, separate from rate limiting on database 0)
CELERY_BROKER_URL=redis://redis:6379/1

# Django cache (login throttling). Redis database 2.
CACHE_URL=redis://redis:6379/2

# Max login/register attempts per client IP (DRF format: N/second|minute|hour)
# AUTH_THROTTLE_RATE=10/min

# --- Optional -------------------------------------------------------------
# Public port of the production-like run (docker-compose.prod.yml)
# WEB_PORT=8080
# PyPI / npm mirrors for slow or restricted networks (used when building images)
# PIP_INDEX_URL=https://pypi.org/simple
# NPM_REGISTRY=https://registry.npmjs.org/
